# ════════════════════════════════════════════════════════════════════════════════
# ForgeIQ - Environment Variables Configuration
# Copy this file to .env before running: cp .env.example .env
# Do NOT commit actual secrets or API keys to version control!
# ════════════════════════════════════════════════════════════════════════════════

# ── Database Configuration ──────────────────────────────────────────────────
# SQLite (default — zero-config local dev and Render free tier)
DATABASE_URL=sqlite:///./forgeiq.db

# PostgreSQL with pgvector (for Docker Compose / Production with full AI features)
# DATABASE_URL=postgresql://user:password@localhost:5432/forgeiq_db

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=forgeiq_db

# ── Backend Security & CORS ──────────────────────────────────────────────────
# In production, replace * with your actual frontend URL(s):
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# ── AI Provider Configuration ────────────────────────────────────────────────
# Provider options: "deterministic" (offline rule-based), "openai", "anthropic"
AI_PROVIDER=deterministic

# External LLM API Keys (optional if using deterministic mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Document Storage & Ingestion Limits ───────────────────────────────────────
STORAGE_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── Frontend API Endpoint ────────────────────────────────────────────────────
# Set this to your deployed backend URL when deploying the frontend:
# NEXT_PUBLIC_API_URL=https://forgeiq-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
