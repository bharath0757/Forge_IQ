CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
AI_PROVIDER=deterministic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STORAGE_DIR=uploads
MAX_FILE_SIZE_MB=50
